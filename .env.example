# CaptivateIQ configuration
# Copy this file to .env and fill in your actual values

# Required — create under CaptivateIQ user profile → API Tokens
TAP_CAPTIVATEIQ_AUTH_TOKEN=your_token_here

# Optional
TAP_CAPTIVATEIQ_API_URL=https://api.captivateiq.com
TAP_CAPTIVATEIQ_START_DATE=2025-01-01T00:00:00Z
TAP_CAPTIVATEIQ_REQUEST_DELAY_MS=250
TAP_CAPTIVATEIQ_PAYOUT_DATE_LOOKBACK_DAYS=120
# TAP_CAPTIVATEIQ_LOCKED_ONLY=false
# TAP_CAPTIVATEIQ_WORKSHEET_NAMES=["Summary","Attainment"]
# visualization_exports and time_series_exports are JSON arrays (config.json / meltano.yml).
# visualization: stream_name, report_model_uuid, worksheet_uuid
# time_series: those fields plus period_date
